# Backend API base URL. In production (Cloudflare Pages) this MUST point
# at the public backend URL — the app calls the backend directly (or via the
# platform's /api proxy). Defaults to localhost:4096 for local dev.
VITE_API_BASE_URL=https://buggumaya.duckdns.org
# Legacy alias, still honoured when VITE_API_BASE_URL is unset.
VITE_API_URL=
VITE_WS_URL=
VITE_OPENCODE_USERNAME=opencode
VITE_OPENCODE_PASSWORD=