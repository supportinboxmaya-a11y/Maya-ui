# Backend API base URL. In production (Cloudflare Pages/Vercel) this MUST point
# at the public backend URL — the app calls the backend directly (or via the
# platform's /api proxy). Defaults to the current working tunnel URL when unset.
# Change the tunnel/backend URL by editing ONLY this variable — no source edits.
VITE_API_BASE_URL=https://teach-deutsche-jones-airline.trycloudflare.com
# Legacy alias, still honoured when VITE_API_BASE_URL is unset.
VITE_API_URL=
VITE_WS_URL=
VITE_OPENCODE_USERNAME=
VITE_OPENCODE_PASSWORD=
